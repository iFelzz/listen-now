# Melodyxx – gitignore

# Python cache & type checking
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.mypy_cache/

# Env & credentials
.env
ENV/
cookies.txt

# Virtual environment
venv/

# FFmpeg binaries
ffmpeg/

# Installer files
*.exe
*.msi
*.zip

# Logs
*.log

# Media & user files (Zero-Disk architecture keeps these off server)
*.mp3
*.webm
*.m4a
*.opus
*.part
*.ytdl
*.3gp
downloads/

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
